# Copy to .env.local and fill in the temporary bot credentials locally.
# These variables are read only by the server-side contact endpoint.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# Optional comma-separated hosts used for staging/preview deployments.
# Example: deeptech-family-staging.example-subdomain.workers.dev
CONTACT_ALLOWED_HOSTS=
